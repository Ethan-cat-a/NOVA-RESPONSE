# NOVA V8 endpoint. The default points to Ethan's NOVA V8 app.
NOVA_V8_API_URL=https://nova-v8.vercel.app/api/chat
# Optional. Set this only if your NOVA V8 API requires an API key.
NOVA_V8_API_KEY=
NOVA_V8_MODE=fast

# Microsoft Entra public-client app registration ID.
MICROSOFT_CLIENT_ID=
# Optional. "common" supports personal Microsoft accounts and work/school accounts.
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common

# Exact email addresses whose message content may be sent to NOVA V8.
# Example: ALLOWED_SENDERS=you@outlook.com,teammate@example.com
ALLOWED_SENDERS=
REPLY_TONE=Warm, clear, concise, and professional.
BUSINESS_CONTEXT=Write helpful, concise email replies. Do not invent policies, prices, promises, or facts.

# Optional dashboard password. Required if HOST is not loopback.
DASHBOARD_PASSWORD=
HOST=127.0.0.1
PORT=3000
