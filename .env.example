# Vercel AI Gateway (local/server use). Never commit a real key.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=amazon/nova-2-lite
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Resend inbound email and manual reply delivery
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
REPLY_FROM=NOVA RESPONSE <reply@your-verified-domain.com>

# Safety: incoming messages are processed only for exact addresses listed here.
# Keep this empty until you have reviewed your setup.
ALLOWED_SENDERS=

# Optional context used only to help the model write accurate drafts.
BUSINESS_CONTEXT=Write helpful, concise email replies. Do not invent policies, prices, promises, or facts.
REPLY_TONE=Warm, clear, concise, and professional.

# Local dashboard binds to loopback by default. Set a password before exposing it publicly.
DASHBOARD_PASSWORD=
HOST=127.0.0.1
PORT=3000
